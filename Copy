                PlaceholderColor3 = Color3.fromRGB(120, 120, 140),
                Font = Enum.Font.GothamMedium,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left
            }, row)

            box.FocusLost:Connect(function(enterPressed)
                pcall(callback, box.Text)
            end)

            return box
        end

        return TabMethods
    end

    return WindowObj
end

